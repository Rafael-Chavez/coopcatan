{
  "buildCommand": "cd catan-engine/client && npm install && npm run build",
  "outputDirectory": "catan-engine/client/dist",
  "devCommand": "cd catan-engine/client && npm run dev",
  "installCommand": "cd catan-engine/client && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "env": {
    "VITE_SERVER_URL": "https://your-server-url.vercel.app"
  }
}
